# PowerPlays admin panel (/admin). Leave ADMIN_PASSWORD unset to disable it.
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin session cookie (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=
# GitHub fine-grained token with "Contents: Read and write" on the repo below.
# Without it, `npm run dev` saves to the local files instead.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPO=Bolabet/BolaChat
ADMIN_GITHUB_BRANCH=main
